{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"custom": {
			"color": {
				"neutral": {
					"50": "#F9FAFB",
					"100": "#F3F4F6",
					"200": "#E5E7EB",
					"300": "#D1D5DB",
					"400": "#9CA3AF",
					"500": "#6B7280",
					"600": "#475569",
					"700": "#4B5563",
					"800": "#374151",
					"900": "#111827"
				},
				"focus": "#FFDD00",
				"focus-contrast": "var:custom|color|neutral|800",
				"error": "#7F1D1D",
				"error-surface": "#FEE2E2",
				"warning": "#C75F18",
				"warning-surface": "#FEF3C7",
				"success": "#14532D",
				"success-surface": "#DCFCE7",
				"shadow": "var:custom|color|neutral|900"
			},
			"scheme": {
				"default": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|contrast",
					"heading": "var:preset|color|contrast",
					"muted": "var:custom|color|neutral|500",
					"link": "var:preset|color|brand-primary",
					"border": "var:custom|color|neutral|200",
					"border-strong": "var:custom|color|neutral|300",
					"button-background": "var:preset|color|brand-primary",
					"button-text": "var:preset|color|base"
				},
				"tint": {
					"background": "var:preset|color|tint-primary",
					"text": "var:preset|color|contrast",
					"heading": "var:preset|color|contrast",
					"muted": "var:custom|color|neutral|600",
					"link": "var:preset|color|brand-primary",
					"border": "var:custom|color|neutral|300",
					"border-strong": "var:custom|color|neutral|400",
					"button-background": "var:preset|color|brand-primary",
					"button-text": "var:preset|color|base"
				},
				"brand": {
					"background": "var:preset|color|brand-primary",
					"text": "var:preset|color|base",
					"heading": "var:preset|color|base",
					"muted": "var:preset|color|brand-secondary",
					"link": "var:preset|color|base",
					"border": "rgb(255 255 255 / 20%)",
					"border-strong": "rgb(255 255 255 / 40%)",
					"button-background": "var:preset|color|base",
					"button-text": "var:preset|color|brand-primary"
				},
				"contrast": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base",
					"heading": "var:preset|color|base",
					"muted": "var:custom|color|neutral|400",
					"link": "var:preset|color|brand-secondary",
					"border": "var:custom|color|neutral|800",
					"border-strong": "var:custom|color|neutral|700",
					"button-background": "var:preset|color|base",
					"button-text": "var:preset|color|contrast"
				}
			},
			"global": {
				"is-rounded": 0
			},
			"layout": {
				"content": "768px",
				"wide": "1280px"
			},
			"spacing": {
				"edge": "clamp(var(--wp--preset--spacing--2-xl), 5.3333px + 5.8333vw, var(--wp--preset--spacing--6-xl))",
				"blockGap": "var:preset|spacing|xl",
				"sectionGap": "var:preset|spacing|5-xl",
				"rowGap": "clamp(var(--wp--preset--spacing--2-xl), 5.3333px + 5.8333vw, var(--wp--preset--spacing--4-xl))",
				"columnGap": "var:preset|spacing|3-xl"
			},
			"typography": {
				"fontWeight": {
					"primary": 400,
					"secondary": 700
				},
				"lineHeight": {
					"none": "1",
					"tight": "1.1",
					"normal": "1.5"
				},
				"letterSpacing": {
					"tighter": "-0.05em",
					"normal": "0em"
				}
			},
			"transition": {
				"duration": {
					"quick": "150ms",
					"normal": "300ms"
				},
				"timing": {
					"ease-out": "ease-out"
				}
			}
		}
	}
}
