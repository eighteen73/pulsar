{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"custom": {
			"scheme": {
				"default": {
					"background": "var:preset|color|base",
					"background-surface": "var:preset|color|neutral-50",
					"background-fill": "var:preset|color|brand-primary",
					"text": "var:preset|color|contrast",
					"text-subtle": "var:preset|color|neutral-600",
					"text-heading": "var:preset|color|brand-primary",
					"text-link": "var:preset|color|accent-primary",
					"text-fill": "var:preset|color|base",
					"border": "var:preset|color|neutral-200",
					"border-strong": "var:preset|color|neutral-400",
					"highlight": "var:preset|color|accent-primary"
				},
				"subtle": {
					"background": "var:preset|color|brand-primary-subtle",
					"background-surface": "var:preset|color|base",
					"background-fill": "var:preset|color|brand-primary",
					"text": "var:preset|color|contrast",
					"text-subtle": "var:preset|color|neutral-700",
					"text-heading": "var:preset|color|brand-primary",
					"text-link": "var:preset|color|accent-primary-strong",
					"text-fill": "var:preset|color|base",
					"border": "var:preset|color|neutral-200",
					"border-strong": "var:preset|color|neutral-500",
					"highlight": "var:preset|color|accent-primary-strong"
				},
				"brand": {
					"background": "var:preset|color|brand-primary",
					"background-surface": "var:preset|color|brand-primary-strong",
					"background-fill": "var:preset|color|accent-secondary",
					"text": "var:preset|color|base",
					"text-subtle": "var:preset|color|brand-primary-subtle",
					"text-heading": "var:preset|color|base",
					"text-link": "var:preset|color|accent-secondary",
					"text-fill": "var:preset|color|contrast",
					"border": "var:preset|color|neutral-700",
					"border-strong": "var:preset|color|neutral-400",
					"highlight": "var:preset|color|accent-secondary"
				},
				"contrast": {
					"background": "var:preset|color|contrast",
					"background-surface": "var:preset|color|neutral-950",
					"background-fill": "var:preset|color|accent-secondary",
					"text": "var:preset|color|base",
					"text-subtle": "var:preset|color|neutral-300",
					"text-heading": "var:preset|color|base",
					"text-link": "var:preset|color|accent-secondary",
					"text-fill": "var:preset|color|contrast",
					"border": "var:preset|color|neutral-800",
					"border-strong": "var:preset|color|neutral-500",
					"highlight": "var:preset|color|accent-secondary"
				}
			},
			"roundness": 1,
			"spacing": {
				"edge": "clamp(24px, 3.4286px + 6.4286vw, 96px)",
				"gutter": "clamp(32px, 27.4286px + 1.4286vw, 48px)",
				"section": "clamp(64px, 54.8571px + 2.8571vw, 96px)"
			},
			"typography": {
				"fontWeight": {
					"body": 400,
					"heading": 700,
					"label": "var(--wp--custom--typography--font-weight--heading)"
				},
				"lineHeight": {
					"none": "1",
					"tight": "1.1",
					"normal": "1.5"
				}
			},
			"transition": {
				"duration": {
					"quick": "150ms",
					"normal": "300ms"
				}
			}
		}
	}
}
