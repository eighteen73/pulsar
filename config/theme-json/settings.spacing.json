{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"spacing": {
			"blockGap": false,
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"margin": false,
			"padding": false,
			"spacingSizes": [
				{
					"name": "XS (4px)",
					"size": "4px",
					"slug": "xs"
				},
				{
					"name": "SM (8px)",
					"size": "8px",
					"slug": "sm"
				},
				{
					"name": "MD (12px)",
					"size": "clamp(8px, 6.8571px + 0.3571vw, 12px)",
					"slug": "md"
				},
				{
					"name": "LG (16px)",
					"size": "clamp(12px, 10.8571px + 0.3571vw, 16px)",
					"slug": "lg"
				},
				{
					"name": "XL (24px)",
					"size": "clamp(16px, 13.7143px + 0.7143vw, 24px)",
					"slug": "xl"
				},
				{
					"name": "2XL (32px)",
					"size": "clamp(24px, 21.7143px + 0.7143vw, 32px)",
					"slug": "2-xl"
				},
				{
					"name": "3XL (48px)",
					"size": "clamp(32px, 27.4286px + 1.4286vw, 48px)",
					"slug": "3-xl"
				},
				{
					"name": "4XL (64px)",
					"size": "clamp(48px, 43.4286px + 1.4286vw, 64px)",
					"slug": "4-xl"
				},
				{
					"name": "5XL (96px)",
					"size": "clamp(64px, 54.8571px + 2.8571vw, 96px)",
					"slug": "5-xl"
				},
				{
					"name": "6XL (128px)",
					"size": "clamp(96px, 86.8571px + 2.8571vw, 128px)",
					"slug": "6-xl"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		}
	}
}
