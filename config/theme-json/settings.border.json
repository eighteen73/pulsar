{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"border": {
			"color": false,
			"radius": false,
			"radiusSizes": [
				{
					"name": "xs",
					"slug": "xs",
					"size": "calc(4px * var(--wp--custom--roundness))"
				},
				{
					"name": "sm",
					"slug": "sm",
					"size": "calc(8px * var(--wp--custom--roundness))"
				},
				{
					"name": "md",
					"slug": "md",
					"size": "calc(clamp(10px, 8.2857px + 0.5357vw, 16px) * var(--wp--custom--roundness))"
				},
				{
					"name": "lg",
					"slug": "lg",
					"size": "calc(clamp(16px, 13.7143px + 0.7143vw, 24px) * var(--wp--custom--roundness))"
				},
				{
					"name": "full",
					"slug": "full",
					"size": "calc(9999px * var(--wp--custom--roundness))"
				}
			],
			"style": false,
			"width": false
		}
	}
}
