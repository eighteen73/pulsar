{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": {
				"minViewportWidth": "320px",
				"maxViewportWidth": "1440px"
			},
			"fontFamilies": [
				{
					"name": "Primary",
					"slug": "primary",
					"fontFamily": "'Figtree', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"fontStretch": "normal",
							"src": [
								"file:./assets/fonts/figtree/figtree-v8-latin-regular.woff2"
							]
						},
						{
							"fontFamily": "Figtree",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"fontStretch": "normal",
							"src": [
								"file:./assets/fonts/figtree/figtree-v8-latin-italic.woff2"
							]
						},
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"fontStretch": "normal",
							"src": [
								"file:./assets/fonts/figtree/figtree-v8-latin-700.woff2"
							]
						},
						{
							"fontFamily": "Figtree",
							"fontStyle": "italic",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"fontStretch": "normal",
							"src": [
								"file:./assets/fonts/figtree/figtree-v8-latin-700italic.woff2"
							]
						}
					]
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"fontFamily": "var(--wp--preset--font-family--primary)"
				}
			],
			"fontSizes": [
				{
					"name": "XS",
					"slug": "xs",
					"size": "12px",
					"fluid": false
				},
				{
					"name": "SM",
					"slug": "sm",
					"size": "14px",
					"fluid": false
				},
				{
					"name": "MD",
					"slug": "md",
					"size": "16px",
					"fluid": {
						"min": "16px",
						"max": "16px"
					}
				},
				{
					"name": "LG",
					"slug": "lg",
					"size": "20px",
					"fluid": {
						"min": "19px",
						"max": "20px"
					}
				},
				{
					"name": "XL",
					"slug": "xl",
					"size": "25px",
					"fluid": {
						"min": "23px",
						"max": "25px"
					}
				},
				{
					"name": "2XL",
					"slug": "2-xl",
					"size": "31px",
					"fluid": {
						"min": "28px",
						"max": "31px"
					}
				},
				{
					"name": "3XL",
					"slug": "3-xl",
					"size": "39px",
					"fluid": {
						"min": "33px",
						"max": "39px"
					}
				},
				{
					"name": "4XL",
					"slug": "4-xl",
					"size": "49px",
					"fluid": {
						"min": "40px",
						"max": "49px"
					}
				},
				{
					"name": "5XL",
					"slug": "5-xl",
					"size": "61px",
					"fluid": {
						"min": "48px",
						"max": "61px"
					}
				}
			],
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"lineHeight": false,
			"textAlign": false,
			"textColumns": false,
			"textDecoration": false,
			"textIndent": false,
			"textTransform": false,
			"writingMode": false
		}
	}
}
