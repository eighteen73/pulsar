{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pulsar/card",
	"version": "1.0.0",
	"title": "Card",
	"category": "sections",
	"description": "An image, heading and text, linking on its button or as a whole card. Used inside Cards and carousels.",
	"icon": "index-card",
	"parent": [
		"matter/slot",
		"matter/carousel"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"matter": {
			"scheme": true,
			"tagName": "article",
			"link": true,
			"slots": {
				"media": {
					"allowedBlocks": [
						"core/image"
					],
					"template": [
						[
							"core/image",
							{}
						]
					],
					"templateLock": "contentOnly"
				},
				"content": {
					"allowedBlocks": [
						"core/heading",
						"core/paragraph",
						"core/list",
						"core/buttons"
					],
					"template": [
						[
							"core/heading",
							{
								"level": 3,
								"placeholder": "Card heading"
							}
						],
						[
							"core/paragraph",
							{
								"placeholder": "Describe this card…"
							}
						]
					]
				}
			}
		}
	},
	"textdomain": "pulsar"
}
